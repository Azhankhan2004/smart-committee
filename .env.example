# ---------------------------------------------------------------
# Smart Committee Management System — environment variables
# Copy this file to .env.local for local development.
# On Vercel, add the same keys in Project → Settings → Environment Variables.
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- Supabase (required) ---------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Server only. Used by the scheduler and WhatsApp webhook. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public app URL (recommended) -------------------------------
# e.g. https://smart-committee.vercel.app  (used in docs links / webhook setup)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scheduler (required for automatic reminders) ---------------
# Any long random string. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string

# --- WhatsApp Business Cloud API (optional) ---------------------
# Leave empty to use manual WhatsApp sharing (wa.me links with prefilled text).
# Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
# For delivery-status webhooks (optional but recommended)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
